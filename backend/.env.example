# Batchwise Backend Production Environment Variables
HOST=0.0.0.0
PORT=8000

# SQLite database path (or postgresql://user:pass@host:5432/batchwise)
# NOTE: On ephemeral free cloud tiers (e.g., Render Free Web Service), local SQLite resets
# on container cold start. For permanent production multi-tenant storage, supply a PostgreSQL connection.
BATCHWISE_DATABASE_URL=sqlite:///./batchwise.db

# Allowed CORS origins (comma-separated, without trailing slashes)
# Set this to your production frontend URL (e.g., https://batchwise.vercel.app)
BATCHWISE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Note Parser Provider: "auto", "gemini", or "ollama"
# In "auto" mode: uses Google Gemini if GEMINI_API_KEY is configured, else falls back to Ollama.
BATCHWISE_AI_PROVIDER=auto

# Hosted Google Gemini AI Configuration (Free Tier available at https://aistudio.google.com/)
# Recommended for cloud deployments on Render where local Ollama is not running.
# Never commit your real API key to Git!
GEMINI_API_KEY=
BATCHWISE_GEMINI_MODEL=gemini-1.5-flash
BATCHWISE_GEMINI_TIMEOUT=30.0

# Local Ollama AI service (local-first on desktop/laptop)
# Gemma 3 1B runs locally via Ollama (`ollama run gemma3:1b`).
BATCHWISE_OLLAMA_URL=http://localhost:11434
BATCHWISE_OLLAMA_MODEL=gemma3:1b
BATCHWISE_OLLAMA_TIMEOUT=30.0

